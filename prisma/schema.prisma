// Prisma schema for the HSE Management Platform.
// Provider is SQLite for local development; see DATABASE.md for the PostgreSQL migration path.
// IDs are cuid() strings everywhere so the schema is identical across providers.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ─────────────────────────────────────────────────────────────────────────
// PLATFORM / TENANCY
// ─────────────────────────────────────────────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  industry  String?
  logoUrl   String?
  isActive  Boolean  @default(true)
  settings  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orgUnitTypes         OrgUnitType[]
  orgUnits             OrgUnit[]
  employees            Employee[]
  userOrganizations    UserOrganization[]
  userOrganizationRoles UserOrganizationRole[]
  documents            Document[]
  documentTypes        DocumentType[]
  picklists            Picklist[]
  incidentCategories   IncidentCategory[]
  incidentSeverities   IncidentSeverity[]
  idSequenceConfigs    IdSequenceConfig[]
  incidents            Incident[]
  capaItems            CapaItem[]
  workPlanDocuments    WorkPlanDocument[]
  attendanceRecords    AttendanceRecord[]
  auditLogs            AuditLog[]
  recordDomains        RecordDomain[]
  recordEntries        RecordEntry[]
  safetyOfficers       SafetyOfficer[]
  violationTypes       ViolationType[]
  safetyViolations     SafetyViolation[]
  safety5sViolations   Safety5sViolation[]
  safety5sViolationContents Safety5sViolationContent[]
  safetyWorkshops      SafetyWorkshop[]
  departmentAliases    DepartmentAlias[]
  hseYearlyTargets     HseYearlyTarget[]
  inventoryItems       InventoryItem[]
  inventoryTransactions InventoryTransaction[]
  workInjuryDeductions WorkInjuryDeduction[]

  @@map("organizations")
}

/// Per-organization configurable hierarchy levels (Site, Building, Workshop, Department, Team, ...)
model OrgUnitType {
  id             String   @id @default(cuid())
  organizationId String
  code           String
  name           String
  level          Int      @default(0)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orgUnits     OrgUnit[]

  @@unique([organizationId, code])
  @@map("org_unit_types")
}

/// Flexible, self-referencing org structure so each Organization can model its own hierarchy.
model OrgUnit {
  id             String   @id @default(cuid())
  organizationId String
  unitTypeId     String
  parentId       String?
  code           String
  name           String
  nameVi         String? // Vietnamese display name — name itself stays whatever language it was created in (usually Chinese)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  unitType     OrgUnitType  @relation(fields: [unitTypeId], references: [id])
  parent       OrgUnit?     @relation("OrgUnitHierarchy", fields: [parentId], references: [id])
  children     OrgUnit[]    @relation("OrgUnitHierarchy")

  employees Employee[]
  incidents Incident[]
  recordEntries RecordEntry[]

  @@unique([organizationId, code])
  @@index([organizationId, parentId])
  @@map("org_units")
}

/// Platform-wide login identity. Organization membership/roles live in UserOrganization(Role).
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  isPlatformAdmin Boolean @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  userOrganizations     UserOrganization[]
  userOrganizationRoles UserOrganizationRole[]
  auditLogs             AuditLog[]
  uploadedDocuments     Document[]             @relation("DocumentUploadedBy")
  reportedIncidents     Incident[]             @relation("IncidentReportedBy")
  createdCapaItems      CapaItem[]             @relation("CapaCreatedBy")
  createdWorkPlanDocuments WorkPlanDocument[]   @relation("WorkPlanDocumentCreatedBy")
  enteredRecordVersions RecordVersion[]        @relation("RecordVersionEnteredBy")
  uploadedRecordFiles   RecordFile[]           @relation("RecordFileUploadedBy")
  uploadedRecordEntrySlots RecordEntrySlot[]   @relation("RecordEntrySlotUploadedBy")
  recordedInventoryTransactions InventoryTransaction[] @relation("InventoryTransactionRecordedBy")
  createdWorkInjuryDeductions WorkInjuryDeduction[]  @relation("WorkInjuryDeductionCreatedBy")
  createdSafety5sViolations Safety5sViolation[]   @relation("Safety5sViolationCreatedBy")

  @@map("users")
}

/// Membership of a User in an Organization (independent of which specific roles they hold).
model UserOrganization {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  status         String   @default("active") // active | invited | disabled
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@map("user_organizations")
}

/// Org-scoped roles (platform_admin is a separate top-level flag on User, not a Role row).
model Role {
  id          String   @id @default(cuid())
  key         String   @unique // org_admin | hse_manager | hse_staff | department_manager | department_user | viewer
  name        String
  description String?
  createdAt   DateTime @default(now())

  rolePermissions       RolePermission[]
  userOrganizationRoles UserOrganizationRole[]

  @@map("roles")
}

model Permission {
  id          String @id @default(cuid())
  key         String @unique // e.g. incident.create, capa.approve, org.manage
  module      String // e.g. incident, capa, organization
  description String?

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

/// A user can hold different role(s) in different organizations (powers the Organization Switcher).
model UserOrganizationRole {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  roleId         String
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId, roleId])
  @@index([organizationId, userId])
  @@map("user_organization_roles")
}

/// HSE-domain person. Not every Employee has a login (User) account.
model Employee {
  id             String   @id @default(cuid())
  organizationId String
  orgUnitId      String?
  employeeCode   String
  fullName       String // Vietnamese name (越文名)
  fullNameZh     String? // Chinese name (中文名)
  position       String?
  shift          String?
  email          String?
  phone          String?
  status         String   @default("active") // active | resigned

  // HSE/HR profile fields populated by the employee-import pipeline (src/server/employee-import.ts).
  gender         String? // male | female
  education      String?
  birthDate      DateTime?
  nationalId     String? // CCCD / 身份证号码
  orgUnitLevel1  String? // 一级部门
  orgUnitLevel2  String? // 二级部门
  region         String? // 区域
  costCenterName String? // 成本中心名称
  team           String? // 班组
  sourceRowData  Json? // full original spreadsheet row, verbatim, so no imported data is ever lost

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orgUnit      OrgUnit?     @relation(fields: [orgUnitId], references: [id])

  incidentsInvolved       Incident[] @relation("IncidentEmployee")
  incidentsResponsible    Incident[] @relation("IncidentResponsiblePerson")
  capaItemsResponsible    CapaItem[] @relation("CapaResponsiblePerson")
  safetyOfficerLinks      SafetyOfficer[]
  attendanceOverrides     AttendanceRecord[]
  inventoryTransactionsReceived InventoryTransaction[] @relation("InventoryTransactionRecipient")
  workInjuryDeductions    WorkInjuryDeduction[]
  safety5sViolations      Safety5sViolation[]

  @@unique([organizationId, employeeCode])
  @@unique([organizationId, nationalId])
  @@map("employees")
}

/// One manually-set override for a single employee's single calendar day. Absence of a row
/// means "use the computed 3-team rotation default" (see src/server/attendance.ts) — only
/// deviations from that default (shift swap, sick leave, ...) actually get written here, so a
/// month with no exceptions needs zero rows.
model AttendanceRecord {
  id             String   @id @default(cuid())
  organizationId String
  employeeId     String
  date           DateTime // stored at UTC midnight, date-only
  status         String   // day | night | off
  hours          Int? // actual worked hours if it differs from the shift's default 12 — null means "the default"
  notes          String? // reason (sick leave, shift swap, ...) — shown on hover

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([organizationId, employeeId, date])
  @@index([organizationId, date])
  @@map("attendance_records")
}

/// Append-only change history, used across every module.
model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  module         String // e.g. incident, capa, organization
  recordType     String
  recordId       String
  action         String // create | update | delete
  fieldName      String?
  oldValue       String?
  newValue       String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id])

  @@index([organizationId, module, recordId])
  @@map("audit_logs")
}

model DocumentType {
  id             String   @id @default(cuid())
  organizationId String
  code           String
  name           String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documents    Document[]

  @@unique([organizationId, code])
  @@map("document_types")
}

/// Metadata only — actual file bytes live behind the StorageService abstraction (see STORAGE.md).
/// Polymorphic via (module, recordId) so every module (incident, capa, ...) reuses this one table.
model Document {
  id               String   @id @default(cuid())
  organizationId   String
  module           String // e.g. incident, capa
  recordId         String
  documentTypeId   String?
  fileName         String
  fileType         String
  sizeBytes        Int
  storageProvider  String   @default("local")
  storagePath      String
  tag              String? // free-form per-module slot, e.g. CAPA's "before" / "after" comparison photos
  uploadedById     String?
  uploadedAt       DateTime @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documentType DocumentType? @relation(fields: [documentTypeId], references: [id])
  uploadedBy   User?         @relation("DocumentUploadedBy", fields: [uploadedById], references: [id])

  @@index([organizationId, module, recordId])
  @@map("documents")
}

/// Generic reusable config lists reserved for future modules' simple dropdowns
/// (training types, equipment types, ...). Incident category/severity get dedicated,
/// richer tables below because they need extra fields (rank, color).
model Picklist {
  id             String   @id @default(cuid())
  organizationId String
  key            String // e.g. training_type, equipment_type
  name           String
  createdAt      DateTime @default(now())

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items        PicklistItem[]

  @@unique([organizationId, key])
  @@map("picklists")
}

model PicklistItem {
  id         String  @id @default(cuid())
  picklistId String
  label      String
  value      String
  sortOrder  Int     @default(0)
  isActive   Boolean @default(true)

  picklist Picklist @relation(fields: [picklistId], references: [id], onDelete: Cascade)

  @@unique([picklistId, value])
  @@map("picklist_items")
}

/// Configurable Incident ID generation per organization, e.g. ORG1/INC/2026/0001.
model IdSequenceConfig {
  id               String   @id @default(cuid())
  organizationId   String
  module           String // e.g. incident
  prefix           String
  includeYear      Boolean  @default(true)
  includeOrgCode   Boolean  @default(true)
  separator        String   @default("/")
  padLength        Int      @default(4)
  resetPeriod      String   @default("yearly") // yearly | monthly | never
  currentPeriodKey String?
  currentSequence  Int      @default(0)
  updatedAt        DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, module])
  @@map("id_sequence_configs")
}

// ─────────────────────────────────────────────────────────────────────────
// INCIDENT MANAGEMENT MODULE
// ─────────────────────────────────────────────────────────────────────────

model IncidentCategory {
  id             String   @id @default(cuid())
  organizationId String
  code           String
  name           String
  nameVi         String? // Vietnamese display name — name itself stays whatever language it was created in (usually Chinese)
  description    String?
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  incidents    Incident[]

  @@unique([organizationId, code])
  @@map("incident_categories")
}

model IncidentSeverity {
  id             String   @id @default(cuid())
  organizationId String
  code           String
  name           String
  rank           Int // used for sorting / analytics, higher = more severe
  colorHex       String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  incidents    Incident[]

  @@unique([organizationId, code])
  @@map("incident_severities")
}

model Incident {
  id             String   @id @default(cuid())
  organizationId String
  incidentNumber String

  occurredAt DateTime
  reportedAt DateTime @default(now())

  orgUnitId     String?
  locationDetail String?
  equipment      String?

  employeeId             String?
  employeeNameSnapshot   String?
  employeeCodeSnapshot   String?
  departmentSnapshot     String?
  positionSnapshot       String?
  shiftSnapshot          String?

  categoryId String
  severityId String

  description     String
  immediateCause  String?
  rootCause       String?
  correctiveAction String?
  preventiveAction String?

  responsiblePersonId            String?
  responsiblePersonNameSnapshot  String? // set when only a name is known (e.g. Excel import), no matching Employee record
  dueDate             DateTime?
  completionDate       DateTime?

  status String @default("investigating") // investigating | closed
  cost   Float?
  notes  String?

  // Fields populated by the Excel import pipeline (src/server/incident-import.ts).
  costRmb         Float?
  costVnd         Float?
  pointsDeducted  Float?
  injuredBodyPart String?
  factoryCode     String? // 工厂代码 from the monthly HSE report's sheet 01, display-only
  sourceRowData   Json? // full original spreadsheet row, verbatim, so no imported data is ever lost

  reportedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orgUnit           OrgUnit?          @relation(fields: [orgUnitId], references: [id])
  employee          Employee?         @relation("IncidentEmployee", fields: [employeeId], references: [id])
  responsiblePerson Employee?         @relation("IncidentResponsiblePerson", fields: [responsiblePersonId], references: [id])
  category          IncidentCategory  @relation(fields: [categoryId], references: [id])
  severity          IncidentSeverity  @relation(fields: [severityId], references: [id])
  reportedBy        User?             @relation("IncidentReportedBy", fields: [reportedById], references: [id])

  @@unique([organizationId, incidentNumber])
  @@index([organizationId, status])
  @@index([organizationId, severityId])
  @@index([organizationId, occurredAt])
  @@map("incidents")
}

/// Canonical ~20-workshop catalog matching the monthly HSE report's fixed rows/columns
/// (sheets 02-04 of the report Excel) — kept separate from OrgUnit, which is a flat,
/// messy dedup of 5 years of free-text department names used for other purposes
/// (Employee assignment, the Incidents dashboard's raw department filter/chart).
model SafetyWorkshop {
  id             String   @id @default(cuid())
  organizationId String
  code           String
  name           String
  nameVi         String? // Vietnamese display name — `name` itself is Chinese (the canonical form used by the incident-report module)
  groupName      String
  safetyCategory String? // 安全类别 from sheet 04 ("1类" / "2类"), display-only
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  aliases      DepartmentAlias[]
  targets      HseYearlyTarget[]

  @@unique([organizationId, code])
  @@map("safety_workshops")
}

/// Maps a raw Incident.departmentSnapshot string to a canonical SafetyWorkshop.
/// Resolved at report-read time (not frozen on the Incident), so correcting a mapping
/// here immediately changes how past incidents are grouped in sheets 02-04.
model DepartmentAlias {
  id               String  @id @default(cuid())
  organizationId   String
  rawText          String // exact departmentSnapshot value, or "" for null/unset
  safetyWorkshopId String? // null = "Chưa phân loại" — not counted in sheets 02-04

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  safetyWorkshop SafetyWorkshop? @relation(fields: [safetyWorkshopId], references: [id])

  @@unique([organizationId, rawText])
  @@map("department_aliases")
}

/// Leadership-set yearly targets/manual KPI actuals (sheets 04 and 05 of the report),
/// which are not derived from incident data. One row per (workshop-or-null, year, metric).
model HseYearlyTarget {
  id               String @id @default(cuid())
  organizationId   String
  safetyWorkshopId String? // null = factory-wide target (sheet 05)
  year             Int
  metricKey        String
  value            Float

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  safetyWorkshop SafetyWorkshop? @relation(fields: [safetyWorkshopId], references: [id])

  @@unique([organizationId, safetyWorkshopId, year, metricKey])
  @@map("hse_yearly_targets")
}

/// Polymorphic CAPA so Inspection/Audit/Risk/Violation modules can create CAPA later
/// without a new table — only sourceModule needs a new value. sourceModule/sourceRecordId
/// are optional so a CAPA can also stand alone (logged directly against an area, not tied to
/// any other record) — the day-to-day "issue log" workflow, matching the org's own tracking
/// sheet: Khu vực + Vấn đề phát sinh + ảnh trước/sau, not necessarily born from an incident.
model CapaItem {
  id             String @id @default(cuid())
  organizationId String

  sourceModule   String? // incident | inspection | audit | risk | violation | null (standalone)
  sourceRecordId String?

  action    String
  rootCause String?

  area           String? // Khu vực — free text, e.g. "Kho thành phẩm"
  discoveredDate DateTime? // Ngày phát hiện — when the issue was actually found, may predate createdAt
  classification String? // Phân loại vấn đề — one of CAPA_CLASSIFICATIONS
  responsibleDept String? // Bộ phận phụ trách — free text, standalone CAPA's "who owns this" (a team, not a named individual)

  responsiblePersonId String? // still used by the incident-linked CAPA flow (named individual)
  dueDate             DateTime?
  completionDate       DateTime?

  status        String  @default("open") // open | in_progress | completed | overdue | closed
  evidenceNotes String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  responsiblePerson Employee?    @relation("CapaResponsiblePerson", fields: [responsiblePersonId], references: [id])
  createdBy         User?        @relation("CapaCreatedBy", fields: [createdById], references: [id])

  @@index([organizationId, sourceModule, sourceRecordId])
  @@index([organizationId, status])
  @@map("capa_items")
}

/// One row of a monthly "工伤连带责任人扣款名单" (work-injury joint-liability deduction list) —
/// people held jointly responsible for a workplace injury, and the amount deducted from their
/// pay. Snapshotted from the linked Employee at creation time (same reasoning as Incident's own
/// *Snapshot fields) so the row keeps reading correctly even if that employee later transfers
/// department — matching the source Excel's own point-in-time department/position columns.
/// Grouped by periodYear/periodMonth, one group per original workbook sheet ("2026年8月", ...).
model WorkInjuryDeduction {
  id             String @id @default(cuid())
  organizationId String

  periodYear  Int
  periodMonth Int // 1-12

  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id])

  employeeCodeSnapshot  String? // 工号
  fullNameZhSnapshot    String? // 中文名
  fullNameViSnapshot    String // 越文名
  orgUnitLevel1Snapshot String? // 一级部门
  regionSnapshot        String? // 区域
  orgUnitLevel2Snapshot String? // 二级部门
  teamSnapshot          String? // 班组
  shiftSnapshot         String? // 班次
  positionSnapshot      String? // 职位

  accidentDate  DateTime? // 事故发生日期
  reporterName  String? // 调查报告发起人
  fineAmountVnd Int      @default(0) // 罚款金额（越南盾）

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("WorkInjuryDeductionCreatedBy", fields: [createdById], references: [id])

  @@index([organizationId, periodYear, periodMonth])
  @@map("work_injury_deductions")
}

/// A self-contained, freely hand-maintained HSE work plan ("kế hoạch công việc") — e.g. one
/// per quarter — that the HSE manager fills in and shares with leadership. Deliberately has
/// NO relation to Incident/Employee/OrgUnit/CAPA: every field (owner name, dates, status,
/// progress) is plain text/values the user types, so it can describe anything without first
/// needing a matching record to exist elsewhere in the platform.
model WorkPlanDocument {
  id             String @id @default(cuid())
  organizationId String
  name           String

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?          @relation("WorkPlanDocumentCreatedBy", fields: [createdById], references: [id])
  items        WorkPlanItem[]

  @@index([organizationId])
  @@map("work_plan_documents")
}

model WorkPlanItem {
  id         String @id @default(cuid())
  documentId String

  /// Free-text phase/group label (e.g. "Giai đoạn 1: Nâng cấp UI Dashboard") — consecutive
  /// items sharing the same phase render under one group banner; null items are ungrouped.
  phase String?

  title           String
  responsibleName String? // plain text, not an Employee reference
  startDate       DateTime?
  endDate         DateTime?

  status          String @default("not_started") // not_started | in_progress | delayed | completed
  progressPercent Int    @default(0) // 0-100, entered by hand — never computed
  notes           String? // one shared progress note per item, editable from the % quick-picker

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  document WorkPlanDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, sortOrder])
  @@map("work_plan_items")
}

// ─────────────────────────────────────────────────────────────────────────
// RECORDS MODULE (Quản lý hồ sơ) — starts with PCCC (fire-safety), designed
// so a second domain (e.g. Môi trường) can be added later as pure data,
// with no schema change. "Site" (Khu A/B/C) reuses the existing OrgUnit
// table rather than a dedicated site table — see RecordEntry.orgUnitId.
// ─────────────────────────────────────────────────────────────────────────

/// A records domain, e.g. PCCC (fire-safety) or MOI_TRUONG (environment, future).
model RecordDomain {
  id             String  @id @default(cuid())
  organizationId String
  code           String // PCCC, MOI_TRUONG
  name           String
  description    String?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  groups       RecordGroup[]

  @@unique([organizationId, code])
  @@map("record_domains")
}

/// A group of record types within a domain, e.g. A/B/C/D for PCCC.
model RecordGroup {
  id        String  @id @default(cuid())
  domainId  String
  code      String
  name      String
  nameZh    String? // Chinese translation, shown instead of `name` when the viewer's locale is zh
  sortOrder Int     @default(0)

  domain RecordDomain @relation(fields: [domainId], references: [id], onDelete: Cascade)
  types  RecordType[]

  @@unique([domainId, code])
  @@map("record_groups")
}

/// The shared catalog of standard record types (26 for PCCC) — defined once, never
/// duplicated per site. A RecordEntry is created per site only when it actually applies.
model RecordType {
  id                String  @id @default(cuid())
  groupId           String
  code              String // A1, B2, C10, D5, ...
  name              String
  nameZh            String? // Chinese translation, shown instead of `name` when the viewer's locale is zh
  legalBasis        String?
  legalBasisZh      String?
  frequencyLabel    String? // free-text description, e.g. "6 tháng/lần"
  frequencyLabelZh  String?
  cycleMonths       Int? // periodic cycle in months; null = not periodic (one-off / on-change)
  responsibleUnit   String?
  responsibleUnitZh String?
  sharedAcrossSites Boolean @default(false) // true = one physical record covers all sites (e.g. evacuation map)
  isActive          Boolean @default(true) // hidden, not deleted, so history stays intact
  sortOrder         Int     @default(0)

  group   RecordGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  entries RecordEntry[]

  @@unique([groupId, code])
  @@map("record_types")
}

/// The intersection of one RecordType and one site (OrgUnit) — created only when that
/// standard record actually applies there. No stored "current status": both status axes
/// are computed from the current (non-superseded) RecordVersion at query time, the same
/// way incident dashboard KPIs are computed from raw rows rather than a cached field —
/// avoids ever needing to keep a cache in sync.
model RecordEntry {
  id                String  @id @default(cuid())
  organizationId    String
  recordTypeId      String
  orgUnitId         String // the site (Khu A/B/C) — an existing OrgUnit, not a new table
  responsiblePerson String?
  notApplicable     Boolean @default(false) // explicit "N/A for this site", distinct from "missing"
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recordType   RecordType      @relation(fields: [recordTypeId], references: [id])
  orgUnit      OrgUnit         @relation(fields: [orgUnitId], references: [id])
  versions     RecordVersion[]
  slots        RecordEntrySlot[]

  @@unique([recordTypeId, orgUnitId])
  @@index([organizationId])
  @@map("record_entries")
}

/// A fixed set of independent upload slots per entry (count set by RECORD_ENTRY_SLOT_COUNT in
/// src/lib/records-constants.ts) — for periodic records (e.g. a monthly self-inspection log)
/// where every period's file should stay visible side by side, unlike RecordVersion where a
/// new entry supersedes the old one. Each slot is its own file; slotIndex just fixes its
/// position so the UI always renders the same fixed set of boxes.
model RecordEntrySlot {
  id           String    @id @default(cuid())
  entryId      String
  slotIndex    Int // 1..6
  fileName     String?
  storageType  String? // drive_link | upload
  url          String?
  storagePath  String?
  sizeBytes    Int?
  mimeType     String?
  startDate    DateTime? // ngày bắt đầu
  expiresAt    DateTime? // ngày hết hạn — null for permanent-use documents
  uploadedById String?
  uploadedAt   DateTime?

  entry      RecordEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  uploadedBy User?       @relation("RecordEntrySlotUploadedBy", fields: [uploadedById], references: [id])

  @@unique([entryId, slotIndex])
  @@map("record_entry_slots")
}

/// One update to a RecordEntry. Never overwritten — a new version supersedes the old one
/// (isSuperseded flips to true on the old row), so full compliance history survives audits.
model RecordVersion {
  id                 String    @id @default(cuid())
  entryId            String
  effectiveDate      DateTime? // ngày ký/lập/sự kiện, from the document itself — null only when dateConfidence = unknown
  dateSourceQuote    String? // verbatim quote of where the date was read, e.g. "Tây Ninh, ngày 03 tháng 06 năm 2026"
  dateConfidence     String // confirmed | estimated | unknown
  expiresAt          DateTime? // auto = effectiveDate + recordType.cycleMonths at create time, unless manually overridden
  expiresAtIsManual  Boolean   @default(false)
  verificationStatus String    @default("ok") // ok | needs_verification | conflict
  notes              String?
  enteredById        String?
  enteredAt          DateTime  @default(now())
  isSuperseded       Boolean   @default(false)
  supersededById     String?   @unique // the newer version that replaced this one

  entry        RecordEntry     @relation(fields: [entryId], references: [id], onDelete: Cascade)
  enteredBy    User?           @relation("RecordVersionEnteredBy", fields: [enteredById], references: [id])
  supersededBy RecordVersion?  @relation("RecordVersionSupersedes", fields: [supersededById], references: [id])
  supersedes   RecordVersion?  @relation("RecordVersionSupersedes")
  files        RecordFile[]

  @@index([entryId, isSuperseded])
  @@map("record_versions")
}

/// A file attached to one version — either a Google Drive link (the format every real
/// record uses today) or a real upload via the existing storageService, so nothing about
/// local storage is foreclosed even though the MVP data is 100% Drive links.
model RecordFile {
  id           String   @id @default(cuid())
  versionId    String
  fileName     String
  storageType  String // drive_link | upload
  url          String? // set when storageType = drive_link
  storagePath  String? // set when storageType = upload (relative path under storageService)
  sizeBytes    Int?
  mimeType     String?
  isPrimary    Boolean  @default(false)
  uploadedById String?
  uploadedAt   DateTime @default(now())

  version    RecordVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  uploadedBy User?         @relation("RecordFileUploadedBy", fields: [uploadedById], references: [id])

  @@map("record_files")
}

/// Roster of employees enrolled in the safety-officer (An toàn viên) monthly subsidy
/// program. Wraps an existing Employee rather than duplicating name/department fields,
/// which are always read live off the linked Employee record.
model SafetyOfficer {
  id                String   @id @default(cuid())
  organizationId    String
  employeeId        String
  monthlySubsidyVnd Int      @default(0)
  sortOrder         Int      @default(0)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee          @relation(fields: [employeeId], references: [id])
  violations   SafetyViolation[]

  @@unique([organizationId, employeeId])
  @@map("safety_officers")
}

/// Organization-configurable catalog of standard violation descriptions, shown as a
/// picklist when logging a SafetyViolation (mirrors IncidentCategory's role).
model ViolationType {
  id             String   @id @default(cuid())
  organizationId String
  labelVi        String
  labelZh        String?
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  violations   SafetyViolation[]

  @@map("violation_types")
}

/// One deduction entry against a safety officer's monthly subsidy.
model SafetyViolation {
  id              String   @id @default(cuid())
  organizationId  String
  safetyOfficerId String
  violationTypeId String
  occurredAt      DateTime
  amountVnd       Int      @default(0)
  note            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  safetyOfficer SafetyOfficer @relation(fields: [safetyOfficerId], references: [id], onDelete: Cascade)
  violationType ViolationType @relation(fields: [violationTypeId], references: [id])

  @@map("safety_violations")
}

/// One "5S" workplace-tidiness violation entry, imported from the monthly "员工违规处罚名单"
/// penalty list. Employee/department/position fields are snapshotted at import/entry time
/// (same reasoning as WorkInjuryDeduction) so a row keeps reading correctly even if that
/// employee later transfers department. violationContent stays free text (not a foreign key to
/// Safety5sViolationContent) — the catalog only offers quick-pick suggestions for common
/// wording, it doesn't constrain what can be typed.
model Safety5sViolation {
  id             String @id @default(cuid())
  organizationId String

  periodYear  Int
  periodMonth Int // 1-12, derived from violationDate

  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id])

  employeeCodeSnapshot  String? // 工号
  fullNameZhSnapshot    String? // 中文名
  fullNameViSnapshot    String // 越文名
  orgUnitLevel1Snapshot String? // 一级部门
  regionSnapshot        String? // 区域
  orgUnitLevel2Snapshot String? // 二级部门
  teamSnapshot          String? // 班组
  shiftSnapshot         String? // 班次
  positionSnapshot      String? // 职位

  violationContent String // 违规内容
  violationDate    DateTime // 违规日期
  fineAmountVnd    Int? // 罚款金额（越南盾）— nullable: some real rows carry a non-monetary penalty instead
  note             String? // 备注

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("Safety5sViolationCreatedBy", fields: [createdById], references: [id])

  @@index([organizationId, periodYear, periodMonth])
  @@map("safety_5s_violations")
}

/// Quick-pick catalog of common 5S violation descriptions ("Không mang giày - 未穿鞋", ...),
/// shown as a dropdown next to the free-text violationContent field on Safety5sViolation.
/// Same shape as ViolationType (labelVi/labelZh/sortOrder/isActive) — org-managed, not a fixed
/// enum, so admins can keep adding new wording over time.
model Safety5sViolationContent {
  id             String   @id @default(cuid())
  organizationId String
  labelVi        String
  labelZh        String?
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("safety_5s_violation_contents")
}

/// Catalog of physical HSE/PCCC equipment items tracked by the Inventory module (chuông báo
/// cháy, tủ chữa cháy, đồng phục, ...). Stock is never stored on this model — it's always
/// computed live from InventoryTransaction (same computed-not-cached pattern used by
/// records/attendance/work-plan status), so it can never drift out of sync with the actual
/// movement history.
model InventoryItem {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  nameZh         String?
  unit           String // đơn vị tính: cái, cuộn, bộ, đôi...
  imageUrl       String?
  minStockLevel  Int      @default(0) // tiêu chuẩn tồn kho tối thiểu — dưới mức này thì cảnh báo
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transactions InventoryTransaction[]

  @@map("inventory_items")
}

/// One stock movement: nhập kho (in) or xuất/lãnh kho (out). For "out" transactions,
/// department + note record which department took the item and why — the "báo lãnh" log.
/// Current stock for an item is always SUM(in) - SUM(out) across this table, computed at
/// query time rather than cached.
model InventoryTransaction {
  id              String   @id @default(cuid())
  organizationId  String
  itemId          String
  type            String // in | out
  quantity        Int
  department      String? // bộ phận lãnh — set for type = out
  recipientEmployeeId String? // người lãnh (tùy chọn) — looked up by MSNV, left blank if not given
  isAdjustment    Boolean  @default(false) // true = stock-count correction, not a real lãnh/nhập — hidden from Báo lãnh
  note            String?
  transactionDate DateTime @default(now())
  recordedById    String?
  createdAt       DateTime @default(now())

  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  item              InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  recordedBy        User?         @relation("InventoryTransactionRecordedBy", fields: [recordedById], references: [id])
  recipientEmployee Employee?     @relation("InventoryTransactionRecipient", fields: [recipientEmployeeId], references: [id])

  @@map("inventory_transactions")
}
