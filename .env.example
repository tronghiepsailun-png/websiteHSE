# Copy this file to .env and fill in real values. Never commit .env.

# Database (SQLite for local dev; swap to a postgresql:// URL when migrating to PostgreSQL)
# Read via prisma.config.ts (imports dotenv/config), not by Prisma directly.
DATABASE_URL="file:./dev.db"

# Auth.js
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# Local file storage
STORAGE_ROOT="./storage"
MAX_UPLOAD_SIZE_MB=25

# AI assistant (Q&A + Vietnamese/Chinese translation) — free Google Gemini key from
# https://aistudio.google.com/apikey . Server-side only; leave empty to disable the assistant.
GEMINI_API_KEY=
# Optional: models tried in order (falls through on quota errors / retired models).
# GEMINI_MODELS="gemini-2.5-flash,gemini-2.5-flash-lite"
# Optional: max assistant requests per person per hour (default 30).
# AI_HOURLY_LIMIT=30
