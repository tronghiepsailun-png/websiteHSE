# Copy this file to .env and fill in real values. Never commit .env.

# Database (SQLite for local dev; swap to a postgresql:// URL when migrating to PostgreSQL)
# Read via prisma.config.ts (imports dotenv/config), not by Prisma directly.
DATABASE_URL="file:./dev.db"

# Auth.js
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# Local file storage
STORAGE_ROOT="./storage"
MAX_UPLOAD_SIZE_MB=25
